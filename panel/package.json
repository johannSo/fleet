{
  "name": "panel",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "PORT=${PORT:-4848} TLS_PORT=${TLS_PORT:-0} tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "screenshot": "node scripts/screenshot.mjs",
    "service:install": "./deploy/install-service.sh",
    "service:remove": "./deploy/install-service.sh --remove",
    "service:logs": "journalctl --user -u fleet-panel.service -f -o cat",
    "deploy": "../deploy.sh",
    "screenshot:mobile": "node scripts/screenshot-mobile.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "smol-toml": "^1.9.1",
    "sonner": "^2.0.8",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
