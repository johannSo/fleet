# Settings for compose.yml. Copy to .env and fill in.

# Required: ClickHouse's password (any long random string, e.g. `openssl rand -hex 24`).
CLICKHOUSE_PASSWORD=

# The panel's login. Leave both empty to create the account in the panel on first start
# (with the setup code from `docker compose logs fleet`). Set them to create it, or reset
# its password, on every start. Two-factor sign-in is turned on in the panel (Account).
FLEET_USERNAME=
FLEET_PASSWORD=

# Image tag to run: latest (the newest release), a release like v0.1.0 or 0.1, main, or sha-<commit>.
FLEET_TAG=latest

# Where fleet-agent connects, when the auto-detected LAN/Tailscale addresses aren't right,
# e.g. https://panel.tailnet.ts.net:4443,https://192.168.1.10:4443
FLEET_AGENT_URLS=

# Extra host names the panel answers to (behind a reverse proxy, say), comma-separated.
ALLOWED_HOSTS=

# Ports on the host.
FLEET_PORT=4747
FLEET_TLS_PORT=4443
PROXY_PORT=8317
CLICKHOUSE_PORT=8123

CLICKHOUSE_MEM_LIMIT=2g
TZ=UTC
